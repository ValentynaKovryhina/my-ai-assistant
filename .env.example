# Copy this file to .env (used by the Prisma CLI) and/or .env.local (used by Next.js),
# then replace the placeholder values. Never commit real credentials.

# PostgreSQL connection string (Neon). Find it in the Neon console under "Connect".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Authentication (Auth.js + Google) ---
# Random secret used to encrypt session cookies. Generate one with: npx auth secret
# (or: openssl rand -base64 32). Use a different value for each environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients).
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# The only Google account allowed to sign in.
ALLOWED_GOOGLE_EMAIL="you@example.com"
